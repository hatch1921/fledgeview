{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FledgeView",
  "version": "0.9.39",
  "identifier": "com.hatchappsllc.fledgeview",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HatchApps LLC",
    "copyright": "© 2026 HatchApps LLC. Original work by Frank Hatcher.",
    "category": "Photography",
    "shortDescription": "Photo viewer, culler, quick editor, and exporter",
    "longDescription": "FledgeView: find the sharp frame, sort by lens, finish, and share. Photos never leave the computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "resources": {
      "resources/exiftool/": "exiftool/"
    }
  }
}
